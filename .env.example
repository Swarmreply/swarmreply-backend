# SwarmReply backend — copy to .env for local dev; set the same keys in Railway Variables.
# Never commit real values.

# ── Required to boot ────────────────────────────────────────────
NODE_ENV=production
PORT=3001
DATABASE_URL=            # Supabase Postgres connection string (pooler URL)
JWT_SECRET=              # long random string
ENCRYPTION_KEY=          # 64 hex chars: openssl rand -hex 32
RESEND_API_KEY=          # several services create the Resend client at load time

# ── URLs ────────────────────────────────────────────────────────
FRONTEND_URL=https://app.swarmreply.com
BACKEND_URL=https://api.swarmreply.com
WIDGET_BASE_URL=https://swarmreply.com   # where rep-widget.js / chat-widget.js are hosted

# ── Email ───────────────────────────────────────────────────────
EMAIL_FROM=SwarmReply <hello@swarmreply.com>
SMTP_FROM=SwarmReply <hello@swarmreply.com>
RESEND_TRANSACTIONAL_KEY=
REVIEW_REQUEST_FROM_EMAIL=
SUPPORT_INBOX=

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE_MONTHLY=
STRIPE_PRICE_BASE_ANNUAL=
STRIPE_PRICE_LOCATION_MONTHLY=   # graduated tiers
STRIPE_PRICE_LOCATION_ANNUAL=    # graduated tiers

# ── AI ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=          # AI visibility scans
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
PERPLEXITY_API_KEY=

# ── Google ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.swarmreply.com/api/auth/google/callback
OAUTH_STATE_SECRET=
GOOGLE_PLACES_API_KEY=

# ── Supabase Storage (logo uploads) ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin console ───────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# ── Monitoring ──────────────────────────────────────────────────
SENTRY_DSN=

# ── SMS (stays off until SMS_ENABLED=true) ──────────────────────
SMS_ENABLED=false
SMS_LIVE_DATE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # SwarmReply's OWN number, only for alerts to business owners. E.164, e.g. +18885551234

# ── Per-customer texting numbers (toll-free, auto-provisioned) ───
# Each customer gets their own toll-free number + toll-free verification,
# submitted automatically once they save "Business texting" in Settings.
# Turn this on 1-2 weeks before SMS_ENABLED so verifications are approved.
SMS_PROVISIONING_ENABLED=false
SMS_OPT_IN_IMAGE_URL=                       # public URL of a screenshot showing how contacts consent to texts (required by carriers)
SMS_OPT_IN_TYPE=VERBAL                      # VERBAL | WEB_FORM | PAPER_FORM | VIA_TEXT | MOBILE_QR_CODE
SMS_USE_CASE_CATEGORIES=CUSTOMER_CARE,MARKETING
SMS_VERIFICATION_NOTIFY_EMAIL=              # where Twilio emails verification updates (defaults to the customer's contact email)
SMS_PRIVACY_POLICY_URL=https://swarmreply.com/privacy
SMS_TERMS_URL=https://swarmreply.com/terms
TWILIO_ADDRESS_SID=                         # optional
EMAIL_CAP_PER_LOCATION=

# ── Listings / rank tracking ────────────────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION=
FOURSQUARE_API_KEY=
FOURSQUARE_API_VERSION=
BING_PLACES_API_KEY=
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=

# ── Integrations (only the ones you offer) ──────────────────────
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_API_VERSION=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_WEBHOOK_SIGNING_KEY=
MINDBODY_API_KEY=
META_APP_ID=
META_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
ONBOARDING_FEATURES=
